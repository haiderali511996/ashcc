# Base URL of the decoupled Express API (no trailing slash).
# This frontend and the backend run as two SEPARATE Node.js Apps in cPanel.
NEXT_PUBLIC_API_URL=https://api.alsadiqhealthcare.online

# Public URL of this frontend itself (used for canonical/OG metadata and
# the admin sidebar's "View Website" link).
NEXT_PUBLIC_SITE_URL=https://alsadiqhealthcare.online

PORT=3000
NODE_ENV=production
