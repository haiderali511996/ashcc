NODE_ENV=production
PORT=5000

# MongoDB Atlas connection string (add the database name at the end)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.gyurptj.mongodb.net/ashcc?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# First admin account (used by "npm run seed")
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@alsadiqhealthcare.online
ADMIN_PASSWORD=change_this_password

# Comma separated list of origins allowed to call the API (the Next.js frontend)
CLIENT_URL=https://alsadiqhealthcare.online,http://localhost:3000
